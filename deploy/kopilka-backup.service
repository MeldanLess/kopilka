# Ночная резервная копия PostgreSQL «Копилки».
#
#   sudo cp deploy/kopilka-backup.service /etc/systemd/system/
#   sudo cp deploy/kopilka-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kopilka-backup.timer
#
# Копию снимает скрипт: в ExecStart systemd не подставляет `$(date ...)`,
# поэтому имя файла с датой вычисляет сам скрипт.

[Unit]
Description=Резервная копия базы «Копилки»
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/kopilka
ExecStart=/opt/kopilka/deploy/backup.sh

TimeoutStartSec=600
