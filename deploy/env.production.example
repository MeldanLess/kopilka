# Переменные окружения для боевого стека «Копилки».
#
#   cp deploy/env.production.example env.production
#   chmod 600 env.production
#
# Файл лежит в корне репозитория, а не в `deploy/`: боевой compose-файл
# ищет переменные по пути `./env.production`, и `.gitignore` закрывает этот
# файл от попадания в историю.

# --- База данных -------------------------------------------------------
POSTGRES_USER=kopilka
POSTGRES_DB=kopilka
# Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Приложение ---------------------------------------------------------
# Ключ подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# С таким ключом приложение откажется стартовать: дефолтный ключ в
# production запрещён намеренно.
SECRET_KEY=

# Адрес, с которого приходят запросы из браузера: адрес сайта-портфолио.
CORS_ORIGINS=https://meldanless.github.io

# Уровень логирования: в production по умолчанию JSON-строки.
LOG_LEVEL=INFO

# --- Образы -------------------------------------------------------------
# Теги образов бэкенда. Образы публикуются рабочим процессом релиза при
# отправке тега; пока их нет в реестре, соберите бэкенд на сервере:
#   docker compose -f docker-compose.prod.yml build api
API_IMAGE=ghcr.io/meldanless/kopilka-api:v1.0.0

# --- Адрес API для фронтенда -------------------------------------------
# Адрес зашивается в бандл на этапе сборки образа фронтенда. Обязателен
# префикс /api: nginx отдаёт под ним API, а корень — статику фронтенда.
VITE_API_URL=https://tracker.example.com/api
