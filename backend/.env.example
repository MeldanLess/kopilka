# Скопируйте этот файл в `.env` и поправьте. Настоящий `.env` в git не попадает.
#
#   cp .env.example .env

# --- База данных ---
DATABASE_URL=postgresql+psycopg://kopilka:kopilka@localhost:5432/kopilka
SQL_ECHO=false

# --- Аутентификация ---
# Настоящий ключ генерируется так:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=8

# --- Окружение ---
# В "production" приложение откажется стартовать с ключом по умолчанию.
ENVIRONMENT=development

# --- Логирование ---
# LOG_FORMAT: "console" — читаемая строка в терминале, "json" — один объект
# JSON на строку. При ENVIRONMENT=production по умолчанию стоит "json".
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- CORS (через запятую) ---
# Адреса, с которых разрешено забирать API: локальный фронтенд на Vite и
# собранная версия фронтенда.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
